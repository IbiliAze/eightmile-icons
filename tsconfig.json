{
  "compilerOptions": {
    "target": "ES2022",
    // ESM with one module per icon, so a consumer's bundler drops every icon it does not import.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "jsx": "react-jsx",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // Tests never compile into `dist`; `tsconfig.test.json` typechecks them.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
