{
  "name": "@eightmile/icons",
  "version": "0.3.0",
  "description": "Eight Mile's icons, each in three segments: dynamic (its parts move when its control is hovered), static, and cropped (broken strokes).",
  "license": "MIT",
  "author": "Ibi Hasanli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IbiliAze/eightmile-icons.git"
  },
  "homepage": "https://github.com/IbiliAze/eightmile-icons#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./dynamic": {
      "types": "./dist/dynamic/index.d.ts",
      "default": "./dist/dynamic/index.js"
    },
    "./dynamic/*": {
      "types": "./dist/dynamic/*.d.ts",
      "default": "./dist/dynamic/*.js"
    },
    "./static": {
      "types": "./dist/static/index.d.ts",
      "default": "./dist/static/index.js"
    },
    "./static/*": {
      "types": "./dist/static/*.d.ts",
      "default": "./dist/static/*.js"
    },
    "./cropped": {
      "types": "./dist/cropped/index.d.ts",
      "default": "./dist/cropped/index.js"
    },
    "./cropped/*": {
      "types": "./dist/cropped/*.d.ts",
      "default": "./dist/cropped/*.js"
    },
    "./motion.css": "./dist/motion.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/generate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "gallery": "npm run build && node scripts/gallery.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg-path-properties": "^2.2.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
